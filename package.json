{
  "name": "udemy-webos-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Personal webOS hosted-app launcher for Udemy",
  "scripts": {
    "test": "node --test test/launcher.test.cjs",
    "package": "mkdir -p dist && ares-package --no-minify app -o dist",
    "install:tv": "ares-install -d webos_tv dist/com.ataman.udemyviewer_0.1.0_all.ipk",
    "launch:tv": "ares-launch -d webos_tv com.ataman.udemyviewer",
    "postinstall": "patch-package",
    "launch:sim": "ares-launch -s 26 app"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "patch-package": "^8.0.1"
  },
  "license": "MIT"
}
